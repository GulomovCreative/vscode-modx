{
	"name": "vscode-modx",
	"displayName": "IntelliSense for MODX",
	"description": "Intelligent MODX, pdoTools and fenom tooling for VS Code",
	"author": {
		"name": "Gulomov Bakhtovar",
		"email": "gulomovcreative@gmail.com",
		"url": "https://codesolution.io"
	},
	"license": "MIT",
	"version": "1.3.1",
	"homepage": "https://github.com/GulomovCreative/vscode-modx",
	"bugs": {
		"url": "https://github.com/GulomovCreative/vscode-modx/issues",
		"email": "gulomovcreative@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GulomovCreative/vscode-modx.git"
	},
	"publisher": "gulomov",
	"keywords": [
		"modx",
		"modxrevolution",
		"modxcms",
		"fenom",
		"pdotools",
		"minishop2",
		"intellisense",
		"autocomplete",
		"vscode"
	],
	"engines": {
		"vscode": "^1.81.0"
	},
	"categories": [
		"Other"
	],
	"galleryBanner": {
		"color": "#2d3442",
		"theme": "dark"
	},
	"icon": "media/modx.png",
	"activationEvents": [
		"onLanguage:modx",
		"onLanguage:fenom"
	],
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"capabilities": {
		"virtualWorkspaces": true
	},
	"l10n": "./l10n",
	"contributes": {
		"languages": [
			{
				"id": "modx",
				"aliases": [
					"MODX",
					"modx"
				],
				"extensions": [
					".tpl"
				],
				"configuration": "./languages/modx-configuration.json",
				"icon": {
					"light": "media/modx.png",
					"dark": "media/modx.png"
				}
			},
			{
				"id": "fenom",
				"aliases": [
					"Fenom",
					"fenom"
				],
				"extensions": [
					".tpl"
				],
				"configuration": "./languages/fenom-configuration.json",
				"icon": {
					"light": "media/fenom.png",
					"dark": "media/fenom.png"
				}
			}
		],
		"grammars": [
			{
				"language": "modx",
				"scopeName": "text.html.modx",
				"path": "./languages/modx.tmLanguage.json"
			},
			{
				"language": "fenom",
				"scopeName": "text.html.fenom",
				"path": "./languages/fenom.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "MODX IntelliSense",
			"properties": {
				"vscode-modx.elementsPath": {
					"type": "string",
					"default": "/core/elements/",
					"description": "%vscode-modx.elementsPath.description%"
				},
				"vscode-modx.diagnostics": {
					"type": "string",
					"default": "unclosed",
					"enum": [
						"off",
						"unclosed",
						"all"
					],
					"enumDescriptions": [
						"%vscode-modx.diagnostics.off%",
						"%vscode-modx.diagnostics.unclosed%",
						"%vscode-modx.diagnostics.all%"
					],
					"description": "%vscode-modx.diagnostics.description%"
				}
			}
		},
		"htmlLanguageParticipants": [
			{
				"languageId": "modx",
				"autoInsert": true
			},
			{
				"languageId": "fenom",
				"autoInsert": true
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run sync-grammars && npm run esbuild-base -- --minify && npm run esbuild-web -- --minify",
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
		"esbuild-web": "esbuild ./src/extension.ts --bundle --outfile=dist/web/extension.js --external:vscode --format=cjs --platform=browser",
		"esbuild": "npm run esbuild-base -- --sourcemap && npm run esbuild-web -- --sourcemap",
		"esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
		"package": "vsce package",
		"publish": "vsce publish",
		"lint": "eslint",
		"sync-grammars": "node scripts/sync-grammars.js",
		"typecheck": "tsc -p ./",
		"typecheck-watch": "tsc -p ./ --watch",
		"test": "node --test \"test/*.test.js\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gulomov/fenom-tmlanguage": "^2.1.0",
		"@gulomov/modx-tmlanguage": "^2.1.0",
		"@types/node": "^16.18.34",
		"@types/vscode": "^1.81.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0"
	}
}
