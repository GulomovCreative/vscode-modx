{
  "comments": {
    "blockComment": ["[[- ", " ]]"]
  },
  "brackets": [
    ["[[", "]]"],
    ["<", ">"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[[", "close": "]]" },
    { "open": "`", "close": "`", "notIn": ["comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["[[", "]]"],
    ["`", "`"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\[\\[(?!-)(?:[^\\]`]|`[^`]*`|\\](?!\\]))*$",
    "decreaseIndentPattern": "^(?:[^\\[`]|`[^`]*`|\\[(?!\\[))*\\]\\]"
  },
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#region\\b",
      "end": "^\\s*<!--\\s*#endregion\\b"
    }
  }
}
